{
    "manifest_version": 3,
    "name": "Trin",
    "description": "Transliterate among Indian scripts",
    "version": "0.2.0",
    "author": "Eklavya Sharma",
    "homepage_url": "https://sharmaeklavya2.github.io/trin/",
    "icons": {
        "32": "icons/32.png",
        "256": "icons/256.png"
    },
    "permissions": ["storage"],
    "content_scripts": [{
        "css": ["trin.css"],
        "js": ["trinContentScript.js"],
        "matches": ["<all_urls>"]
    }],
    "web_accessible_resources": [{
        "resources": ["trin.js", "trinUI.js"],
        "matches": ["<all_urls>"]
    }]
}
